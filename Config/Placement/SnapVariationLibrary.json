{
  "schemaVersion": "2.0.0",
  "libraryId": "myproject3.global-placement.profile-catalog",
  "status": "runtime-consumed-source-catalogue",
  "units": {
    "distance": "cm",
    "angle": "degrees"
  },
  "coreRules": [
    "All placement decisions use one kernel; domain families provide geometry and material rules through adapters.",
    "Stable feature IDs are used for persistent links. Array indices are transient UI/lookup details only.",
    "Logical stations, contact frames, authored anchors, cut targets, receiver slots and voxel cells are distinct concepts.",
    "Hard-invalid candidates are rejected before scoring; proximity cannot rescue an invalid candidate.",
    "Multi-anchor placement reserves and commits every required connection together or rolls the whole operation back.",
    "No ordinary placement profile silently converts to hinge, ground-rest, diagonal-brace or free-placement semantics.",
    "Radial frames are resolved from the contact direction at runtime; do not spawn a point for each rotation.",
    "Physics policy is explicit and separate from structural connection policy."
  ],
  "anchorGeneration": {
    "log": {
      "moduleLengthCm": 75,
      "maximumStandardLengthCm": 600,
      "standardLengthsCm": [
        75,
        150,
        225,
        300,
        375,
        450,
        525,
        600
      ],
      "endAnchors": {
        "count": 2,
        "positionRule": "actual_mesh_end_planes",
        "roles": [
          "log.end",
          "log.end"
        ],
        "generatedFromActualGeometry": true
      },
      "surfaceStations": {
        "meaning": "One logical contact station per complete 75 cm module. Each station is a centerline feature; radial contact is computed from the hit hint.",
        "countRule": "floor(actualLengthCm / 75)",
        "positionRule": "center_of_each_complete_module_from_actual_negative_axis_end",
        "firstStationOffsetCm": 37.5,
        "spacingCm": 75,
        "maximumCountAt600Cm": 8,
        "example600CmPositionsCm": [
          37.5,
          112.5,
          187.5,
          262.5,
          337.5,
          412.5,
          487.5,
          562.5
        ],
        "radialFrameRule": "project_world_hit_hint_into_cross_section; use continuous radial frame for round sections and closest authored side face for hewn/square sections",
        "anchorRepresentation": "stable logical station ID plus runtime contact frame",
        "doNotSpawnPerRotation": true
      },
      "cutStations": {
        "defaultStepCm": 75,
        "targetRule": "integer multiples of 75 cm strictly between actual endpoints",
        "snapAndCutAreSeparateCapabilities": true,
        "partialCutDoesNotChangePieceTopology": true,
        "completedCutRebuildsEndAnchorsAndSurfaceStations": true,
        "legacyFineCutProfile": "log.free_cut_25cm"
      },
      "nonStandardLengths": {
        "policy": "Always derive endpoints from real geometry. Generate only complete 75 cm modules. Do not infer dimensions from asset names.",
        "neverAssumeLengthFromAssetName": true
      }
    }
  },
