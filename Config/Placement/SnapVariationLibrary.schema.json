{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/myproject3/SnapVariationLibrary.schema.json",
  "title": "MyProject3 Global Placement Profile Catalog",
  "description": "Versioned runtime-consumed data contract for placement, connection, surface placement, receiver interaction, voxel operations and geometry processing.",
  "type": "object",
  "required": [
    "schemaVersion",
    "libraryId",
    "status",
    "units",
    "coreRules",
    "anchorGeneration",
    "connectionProfiles",
    "surfacePlacementProfiles",
    "receiverInteractionProfiles",
    "voxelOperationProfiles",
    "geometryProcessingProfiles",
    "resolutionPipeline",
    "scoring",
    "integrationStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "libraryId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "object",
      "required": [
        "distance",
        "angle"
      ],
      "properties": {
        "distance": {
          "const": "cm"
        },
        "angle": {
          "const": "degrees"
        }
      },
      "additionalProperties": false
    },
    "coreRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "anchorGeneration": {
      "type": "object",
      "required": [
        "log"
      ],
      "properties": {
        "log": {
          "type": "object",
          "required": [
            "moduleLengthCm",
            "maximumStandardLengthCm",
            "standardLengthsCm",
            "endAnchors",
            "surfaceStations",
            "cutStations",
            "nonStandardLengths"
          ],
          "properties": {
            "moduleLengthCm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maximumStandardLengthCm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "standardLengthsCm": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "endAnchors": {
              "type": "object",
              "required": [
                "count",
                "positionRule",
                "roles",
                "generatedFromActualGeometry"
              ],
              "properties": {
                "count": {
                  "const": 2
                },
                "positionRule": {
                  "type": "string"
                },
                "roles": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "generatedFromActualGeometry": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "surfaceStations": {
              "type": "object",
              "required": [
                "countRule",
                "positionRule",
                "spacingCm",
                "maximumCountAt600Cm",
                "example600CmPositionsCm",
                "radialFrameRule",
                "anchorRepresentation",
                "doNotSpawnPerRotation"
              ],
              "properties": {
                "countRule": {
                  "type": "string"
                },
                "positionRule": {
                  "type": "string"
                },
                "spacingCm": {
                  "const": 75
                },
                "maximumCountAt600Cm": {
                  "const": 8
                },
                "example600CmPositionsCm": {
                  "type": "array",
                  "minItems": 8,
                  "maxItems": 8,
                  "items": {
                    "type": "number"
                  }
                },
                "radialFrameRule": {
                  "type": "string"
                },
                "anchorRepresentation": {
                  "type": "string"
                },
                "doNotSpawnPerRotation": {
                  "const": true
                }
              },
              "additionalProperties": false
            },
            "cutStations": {
              "type": "object",
              "required": [
                "defaultStepCm",
                "targetRule",
                "snapAndCutAreSeparateCapabilities",
                "partialCutDoesNotChangePieceTopology",
                "completedCutRebuildsEndAnchorsAndSurfaceStations",
                "legacyFineCutProfile"
              ],
              "properties": {
                "defaultStepCm": {
                  "const": 75
                },
                "targetRule": {
                  "type": "string"
                },
                "snapAndCutAreSeparateCapabilities": {
                  "const": true
                },
                "partialCutDoesNotChangePieceTopology": {
                  "const": true
                },
                "completedCutRebuildsEndAnchorsAndSurfaceStations": {
                  "const": true
                },
                "legacyFineCutProfile": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "nonStandardLengths": {
              "type": "object",
              "required": [
                "policy",
                "neverAssumeLengthFromAssetName"
              ],
              "properties": {
                "policy": {
                  "type": "string"
                },
                "neverAssumeLengthFromAssetName": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "connectionProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "surfacePlacementProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "receiverInteractionProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "voxelOperationProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "geometryProcessingProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "resolutionPipeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "hardRejectBeforeScoring",
        "softPreferences",
        "forbiddenFallbacks"
      ],
      "properties": {
        "hardRejectBeforeScoring": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "softPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbiddenFallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "integrationStatus": {
      "type": "object",
      "required": [
        "catalogueCreated",
        "runtimeKernelImplemented",
        "logSingleAnchorPathMigrated",
        "logTwoSupportTransactionImplemented",
        "legacyStackAndStrutAdaptersIntegrated",
        "stoneStickAdaptersContracted",
        "fireVoxelOperationProfilesDefined",
        "assetCatalogAutomationAdded",
        "unrealBuildVerified",
        "pieGameplayVerified"
      ],
      "properties": {
        "catalogueCreated": {
          "type": "boolean"
        },
        "runtimeKernelImplemented": {
          "type": "boolean"
        },
        "logSingleAnchorPathMigrated": {
          "type": "boolean"
        },
        "logTwoSupportTransactionImplemented": {
          "type": "boolean"
        },
        "legacyStackAndStrutAdaptersIntegrated": {
          "type": "boolean"
        },
        "stoneStickAdaptersContracted": {
          "type": "boolean"
        },
        "fireVoxelOperationProfilesDefined": {
          "type": "boolean"
        },
        "assetCatalogAutomationAdded": {
          "type": "boolean"
        },
        "unrealBuildVerified": {
          "type": "boolean"
        },
        "pieGameplayVerified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "id",
        "family",
        "operationKind",
        "geometry",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_]+)+$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "operationKind": {
          "enum": [
            "connection",
            "surface_placement",
            "receiver_interaction",
            "voxel_operation",
            "geometry_processing"
          ]
        },
        "geometry": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceFeatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetFeatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "solver": {
          "type": "string",
          "minLength": 1
        },
        "orientationPolicy": {
          "type": "string"
        },
        "translationToleranceCm": {
          "type": "number",
          "minimum": 0
        },
        "angularToleranceDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "angleRangeDeg": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "preferredAnglesDeg": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "maxLengthMismatchCm": {
          "type": "number",
          "minimum": 0
        },
        "minRequiredConnections": {
          "type": "integer",
          "minimum": 0
        },
        "minimumDistinctSupports": {
          "type": "integer",
          "minimum": 0
        },
        "requiresCollisionValidation": {
          "type": "boolean"
        },
        "requiresStructuralValidation": {
          "type": "boolean"
        },
        "requiresSurfaceTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "physicsPolicy": {
          "type": "string"
        },
        "failurePolicy": {
          "type": "string"
        },
        "atomicCommit": {
          "type": "boolean"
        },
        "allowsPhysicsFallback": {
          "type": "boolean"
        },
        "singleEndDowngradeAllowed": {
          "const": false
        },
        "requiresExplicitProfile": {
          "type": "boolean"
        },
        "requiresJoineryOrExplicitOverlapPolicy": {
          "type": "boolean"
        },
        "requiresMatchedMeshPair": {
          "type": "boolean"
        },
        "requiresMaterialCompatibility": {
          "type": "boolean"
        },
        "usesOwnershipTransaction": {
          "type": "boolean"
        },
        "requiresGridCompatibility": {
          "type": "boolean"
        },
        "requiresCellStateValidation": {
          "type": "boolean"
        },
        "requiresNeighborRuleValidation": {
          "type": "boolean"
        },
        "usesVoxelTransaction": {
          "type": "boolean"
        },
        "createsStructuralAnchor": {
          "type": "boolean"
        },
        "cutStepCm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "optionalProfile": {
          "type": "boolean"
        },
        "partialCutChangesTopology": {
          "const": false
        },
        "completedCutCreatesNewPieces": {
          "type": "boolean"
        },
        "rebuildsAnchorsOnCompletion": {
          "type": "boolean"
        },
        "requiresExactMeshVariant": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
