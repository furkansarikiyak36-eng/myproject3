Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.suo
*.xcodeproj
*.xcworkspace
Content/__ExternalActors__/
Content/__ExternalObjects__/

# Source heightmaps: the raw .r16 files stay local; lossless 16-bit PNG copies are in git (LFS) under SourceArt/Heightmaps/png/.
SourceArt/Heightmaps/*
!SourceArt/Heightmaps/png/
# Archives dropped into Content are not Unreal assets and are too big for GitHub.
Content/*.zip



# Generated plan maps (rebuild: python tools/heightmaps/build_world_masks.py); the PNG previews are kept
SourceArt/World/*.r8
SourceArt/World/masks/*.r8
__pycache__/

# Trial worlds: keep the previews, rebuild the heightmaps
SourceArt/World/*/*.r16
SourceArt/World/*/*.r8

# Trial maps (rebuild with -run=BuildValleyWorld -WorldDir=SourceArt/World/<trial>)
Content/World/World5x5Trial.umap

# Test scenes (one per heightmap): maps and single screenshots stay local; the comparison sheet is kept
Content/World/Test/
Docs/World/test_scenes/*/
