{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myproject3.local/schemas/world-object-instance.schema.json",
  "title": "MyProject3 Persistent World Object Instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instanceId",
    "definitionId",
    "lifecycleState",
    "revision",
    "domain"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "definitionId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "lifecycleState": {
      "enum": [
        "World",
        "Held",
        "Placed",
        "Consumed",
        "Destroyed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "domainState": {
      "type": "object"
    },
    "parentInstanceId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "ownerInstanceId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "saveVersion": {
      "type": "integer",
      "minimum": 1
    }
  }
}
