{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/myproject3/schemas/committed-event.schema.json",
  "title": "MyProject3 Committed Gameplay Event",
  "description": "Envelope for a committed world fact. Runtime broadcaster/persistence integration is a separate task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "operationId",
    "simulationTimeSeconds",
    "affectedInstanceIds",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^EVT_[A-Z0-9_]+$"
    },
    "eventType": {
      "enum": [
        "ObjectProcessed",
        "ResourceConsumed",
        "ConstructionAttached",
        "ConstructionDetached",
        "ConstructionDamaged",
        "TerrainChanged",
        "CropStateChanged",
        "AnimalStateChanged",
        "ProductionCompleted",
        "OwnershipTransferred",
        "DiscoveryRecorded",
        "WeatherChanged",
        "RaidStateChanged"
      ]
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "simulationTimeSeconds": {
      "type": "number",
      "minimum": 0
    },
    "tickIndex": {
      "type": "integer",
      "minimum": 0
    },
    "affectedInstanceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "payload": {
      "type": "object"
    },
    "deliveryPolicy": {
      "enum": [
        "TransientNotify",
        "DurableJournalRequired"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "PLANNED",
        "IMPLEMENTED_UNVERIFIED",
        "VERIFIED",
        "DEFERRED"
      ]
    }
  }
}
