{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myproject3.local/schemas/recipe-definition.schema.json",
  "title": "MyProject3 Recipe / Transformation Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipeId",
    "version",
    "inputs",
    "operation",
    "outputs",
    "atomicity",
    "persistencePolicy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "recipeId": {
      "type": "string",
      "pattern": "^RECIPE_[A-Z0-9_]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "quantity",
          "consume"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unitId": {
            "type": "string"
          },
          "consume": {
            "type": "boolean"
          },
          "requiredState": {
            "type": "string"
          },
          "minDurability": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredToolId": {
          "type": "string"
        },
        "requiredStationId": {
          "type": "string"
        },
        "requiredWorldTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredPieceState": {
          "type": "string"
        },
        "allowedSeasonIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimumTemperature": {
          "type": "number"
        },
        "maximumContamination": {
          "type": "number"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationType",
        "durationSeconds"
      ],
      "properties": {
        "operationType": {
          "enum": [
            "Immediate",
            "ProgressBased",
            "WorldTimeBased",
            "StationQueue"
          ]
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "interruptPolicy": {
          "enum": [
            "Rollback",
            "KeepProgress",
            "CommitAtMilestones"
          ],
          "default": "Rollback"
        },
        "noiseLevel": {
          "type": "number",
          "minimum": 0
        },
        "lightLevel": {
          "type": "number",
          "minimum": 0
        },
        "fuelItemId": {
          "type": "string"
        },
        "fuelQuantity": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "quantity"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unitId": {
            "type": "string"
          },
          "worldRepresentation": {
            "enum": [
              "PhysicalActor",
              "StackablePickup",
              "EquipmentOnly",
              "StoryRecord"
            ]
          }
        }
      }
    },
    "byproducts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "quantity"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unitId": {
            "type": "string"
          }
        }
      }
    },
    "toolWear": {
      "type": "number",
      "minimum": 0
    },
    "atomicity": {
      "enum": [
        "AllOrNothing",
        "MilestoneCommit"
      ],
      "default": "AllOrNothing"
    },
    "persistencePolicy": {
      "enum": [
        "None",
        "SaveInProgress",
        "SaveQueuedOperation",
        "SaveResult"
      ]
    },
    "feedbackEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVT_[A-Z0-9_]+$"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
