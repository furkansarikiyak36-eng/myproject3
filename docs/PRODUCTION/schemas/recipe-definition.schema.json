{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/myproject3/schemas/recipe-definition.schema.json",
  "title": "MyProject3 Recipe Definition",
  "description": "Authoring-time schema for crafting, resource processing and world-state transitions; not yet wired to Unreal runtime loading.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipeId",
    "operationMode",
    "inputs",
    "outputs",
    "preconditions",
    "failurePolicy",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "recipeId": {
      "type": "string",
      "pattern": "^REC_[A-Z0-9_]+$"
    },
    "displayNameKey": {
      "type": "string",
      "minLength": 1
    },
    "operationMode": {
      "enum": [
        "Immediate",
        "ProgressBased",
        "WorldTickBased"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ingredient"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "byproducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredToolDefinitionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TOOL_[A-Z0-9_]+$"
          }
        },
        "requiredStationTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "requiredPieceStates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "requiredMaterialIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MAT_[A-Z0-9_]+$"
          }
        },
        "allowedWeatherStates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Clear",
              "Rain",
              "Wind",
              "Snow",
              "Storm",
              "Heatwave"
            ]
          }
        },
        "seasonIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SEASON_[A-Z0-9_]+$"
          }
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolWear": {
          "type": "number",
          "minimum": 0
        },
        "fuel": {
          "$ref": "#/$defs/cost"
        },
        "water": {
          "$ref": "#/$defs/cost"
        },
        "noiseLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lightLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "resultState": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "eventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(EVT|VFX|SFX)_[A-Z0-9_]+$"
      }
    },
    "failurePolicy": {
      "enum": [
        "AtomicRollback",
        "ExplicitPartialProgress",
        "ConsumeOnSuccessOnly"
      ]
    },
    "interruptPolicy": {
      "enum": [
        "PauseProgress",
        "RollbackProgress",
        "KeepExplicitProgress",
        "NotInterruptible"
      ]
    },
    "persistencePolicy": {
      "enum": [
        "NoSave",
        "SaveInProgressOperation",
        "SaveCompletedResult"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "PLANNED",
        "IMPLEMENTED_UNVERIFIED",
        "VERIFIED",
        "DEFERRED"
      ]
    }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionId",
        "quantity",
        "consume"
      ],
      "properties": {
        "definitionId": {
          "type": "string",
          "pattern": "^(ITEM|MAT|TOOL|EQUIP|SEED|CROP|PART|TECH)_[A-Z0-9_]+$"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "consume": {
          "type": "boolean"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionId",
        "quantity"
      ],
      "properties": {
        "definitionId": {
          "type": "string",
          "pattern": "^(ITEM|MAT|TOOL|EQUIP|SEED|CROP|PART|TECH|BLD)_[A-Z0-9_]+$"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionId",
        "quantity"
      ],
      "properties": {
        "definitionId": {
          "type": "string",
          "pattern": "^(ITEM|MAT)_[A-Z0-9_]+$"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operationMode": {
            "const": "Immediate"
          }
        },
        "required": [
          "operationMode"
        ]
      },
      "then": {
        "properties": {
          "durationSeconds": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operationMode": {
            "enum": [
              "ProgressBased",
              "WorldTickBased"
            ]
          }
        },
        "required": [
          "operationMode"
        ]
      },
      "then": {
        "required": [
          "durationSeconds",
          "interruptPolicy",
          "persistencePolicy"
        ]
      }
    }
  ]
}
