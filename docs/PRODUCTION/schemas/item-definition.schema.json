{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myproject3.local/schemas/item-definition.schema.json",
  "title": "MyProject3 Item Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "itemId",
    "displayNameKey",
    "category",
    "worldRepresentation",
    "unitMassGrams",
    "unitVolumeCm3",
    "maxStack",
    "allowedActions",
    "persistencePolicy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "itemId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "displayNameKey": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "RawMaterial",
        "ProcessedMaterial",
        "Tool",
        "Equipment",
        "Consumable",
        "Seed",
        "BuildPart",
        "Story",
        "TechPart",
        "Crop",
        "AnimalProduct"
      ]
    },
    "worldRepresentation": {
      "enum": [
        "PhysicalActor",
        "StackablePickup",
        "EquipmentOnly",
        "StoryRecord"
      ]
    },
    "unitMassGrams": {
      "type": "integer",
      "minimum": 0
    },
    "unitVolumeCm3": {
      "type": "integer",
      "minimum": 0
    },
    "maxStack": {
      "type": "integer",
      "minimum": 1
    },
    "durabilityModel": {
      "enum": [
        "None",
        "Durability",
        "Charges",
        "Freshness",
        "FilterLife"
      ],
      "default": "None"
    },
    "stateModel": {
      "enum": [
        "None",
        "ProcessingState",
        "CropState",
        "ContaminationState",
        "Wetness",
        "Freshness",
        "Condition"
      ],
      "default": "None"
    },
    "allowedActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "Pickup",
          "Drop",
          "Use",
          "Equip",
          "Process",
          "Place",
          "Consume",
          "Inspect",
          "Repair",
          "Craft"
        ]
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      }
    },
    "persistencePolicy": {
      "enum": [
        "InventorySave",
        "WorldActorSave",
        "DerivedOnly",
        "StoryProgressSave",
        "Transient"
      ]
    },
    "feedbackEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVT_[A-Z0-9_]+$"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "worldRepresentation": {
            "const": "PhysicalActor"
          }
        },
        "required": [
          "worldRepresentation"
        ]
      },
      "then": {
        "properties": {
          "maxStack": {
            "const": 1
          }
        }
      }
    }
  ]
}
