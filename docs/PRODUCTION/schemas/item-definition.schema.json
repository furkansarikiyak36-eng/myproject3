{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/myproject3/schemas/item-definition.schema.json",
  "title": "MyProject3 Item Definition",
  "description": "Authoring-time schema only; not yet wired to Unreal runtime loading.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "definitionId",
    "category",
    "worldRepresentation",
    "massGrams",
    "volumeMillilitres",
    "maxStack",
    "durabilityModel",
    "allowedActions",
    "persistencePolicy",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "definitionId": {
      "type": "string",
      "pattern": "^(ITEM|MAT|TOOL|EQUIP|SEED|CROP|BLD|PART|STORY|TECH)_[A-Z0-9_]+$"
    },
    "displayNameKey": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "RawMaterial",
        "ProcessedMaterial",
        "Tool",
        "Equipment",
        "Consumable",
        "Seed",
        "BuildPart",
        "Story",
        "TechPart"
      ]
    },
    "worldRepresentation": {
      "enum": [
        "PhysicalActor",
        "StackablePickup",
        "InventoryStack",
        "EquipmentOnly",
        "StoryRecord"
      ]
    },
    "massGrams": {
      "type": "number",
      "minimum": 0
    },
    "volumeMillilitres": {
      "type": "number",
      "minimum": 0
    },
    "unitId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "maxStack": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "durabilityModel": {
      "enum": [
        "None",
        "Durability",
        "ConsumableCharges",
        "Freshness",
        "FilterLife"
      ]
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum"
      ],
      "properties": {
        "maximum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "initial": {
          "type": "number",
          "minimum": 0
        },
        "breaksAtZero": {
          "type": "boolean"
        }
      }
    },
    "stateModel": {
      "enum": [
        "None",
        "ProcessingState",
        "CropState",
        "ContaminationState",
        "Wetness",
        "Freshness",
        "FilterLife"
      ]
    },
    "sourceDefinitionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(ITEM|MAT|TOOL|EQUIP|SEED|CROP|BLD|PART|STORY|TECH|REGION)_[A-Z0-9_]+$"
      }
    },
    "recipeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REC_[A-Z0-9_]+$"
      }
    },
    "allowedActions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "Pickup",
          "Drop",
          "Use",
          "Equip",
          "Process",
          "Place",
          "Consume",
          "Inspect",
          "Repair",
          "Store",
          "SplitStack",
          "Transfer"
        ]
      }
    },
    "persistencePolicy": {
      "enum": [
        "Transient",
        "SaveInstance",
        "SaveStack",
        "SaveDefinitionOnly",
        "StoryPersistent"
      ]
    },
    "requiredFeedback": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(EVT|VFX|SFX|MUS)_[A-Z0-9_]+$"
      }
    },
    "status": {
      "enum": [
        "PROPOSED",
        "PLANNED",
        "IMPLEMENTED_UNVERIFIED",
        "VERIFIED",
        "DEFERRED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "worldRepresentation": {
            "const": "PhysicalActor"
          }
        },
        "required": [
          "worldRepresentation"
        ]
      },
      "then": {
        "properties": {
          "maxStack": {
            "const": 1
          },
          "persistencePolicy": {
            "enum": [
              "SaveInstance",
              "StoryPersistent"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "durabilityModel": {
            "const": "None"
          }
        },
        "required": [
          "durabilityModel"
        ]
      },
      "then": {
        "not": {
          "required": [
            "durability"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "durabilityModel": {
            "enum": [
              "Durability",
              "ConsumableCharges",
              "Freshness",
              "FilterLife"
            ]
          }
        },
        "required": [
          "durabilityModel"
        ]
      },
      "then": {
        "required": [
          "durability"
        ]
      }
    }
  ]
}
