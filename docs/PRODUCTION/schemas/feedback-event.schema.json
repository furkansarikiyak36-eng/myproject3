{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myproject3.local/schemas/feedback-event.schema.json",
  "title": "MyProject3 Gameplay Feedback Event Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "trigger",
    "channels",
    "priority",
    "persistence"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^EVT_[A-Z0-9_]+$"
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "UI",
          "Animation",
          "SFX",
          "VFX",
          "Music",
          "Haptic"
        ]
      }
    },
    "priority": {
      "enum": [
        "Critical",
        "High",
        "Normal",
        "Low"
      ]
    },
    "persistence": {
      "enum": [
        "Transient",
        "CommittedFact",
        "DurableProgress"
      ]
    },
    "spatial": {
      "enum": [
        "World3D",
        "Player2D",
        "UIOnly",
        "Adaptive"
      ]
    },
    "sfxId": {
      "type": "string",
      "pattern": "^SFX_[A-Z0-9_]+$"
    },
    "vfxId": {
      "type": "string",
      "pattern": "^VFX_[A-Z0-9_]+$"
    },
    "musicCueId": {
      "type": "string",
      "pattern": "^MUS_[A-Z0-9_]+$"
    },
    "uiMessageKey": {
      "type": "string"
    },
    "animationId": {
      "type": "string",
      "pattern": "^ANIM_[A-Z0-9_]+$"
    },
    "notes": {
      "type": "string"
    }
  }
}
