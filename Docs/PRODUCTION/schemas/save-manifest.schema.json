{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Versioned World Save Manifest",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "schema_version",
    "world_instance_id",
    "world_seed",
    "world_tick",
    "created_at_utc",
    "physical_actors",
    "owned_items",
    "structural_links",
    "terrain_edits",
    "inventories",
    "crops",
    "animals",
    "production",
    "threat_state",
    "survival_state",
    "discoveries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "world_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "world_seed": {
      "type": "integer"
    },
    "world_tick": {
      "type": "integer",
      "minimum": 0
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "physical_actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instance_id",
          "definition_id",
          "transform",
          "domain_state"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "definition_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "transform": {
            "type": "object",
            "required": [
              "location",
              "rotation",
              "scale"
            ],
            "properties": {
              "location": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 3,
                "maxItems": 3,
                "items": false
              },
              "rotation": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 3,
                "maxItems": 3,
                "items": false
              },
              "scale": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 3,
                "maxItems": 3,
                "items": false
              }
            },
            "additionalProperties": false
          },
          "domain_state": {
            "type": "object"
          },
          "held_by_instance_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "owned_items": {
      "type": "array",
      "items": {
        "$ref": "world-owned-item.schema.json"
      }
    },
    "structural_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "parent_instance_id",
          "parent_anchor_id",
          "child_instance_id",
          "child_anchor_id"
        ],
        "properties": {
          "parent_instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "parent_anchor_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "child_instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "child_anchor_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "terrain_edits": {
      "type": "array",
      "items": {
        "$ref": "terrain-edit.schema.json"
      }
    },
    "inventories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "owner_instance_id",
          "items"
        ],
        "properties": {
          "owner_instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "definition_id",
                "quantity"
              ],
              "properties": {
                "definition_id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "item_instance_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "crops": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "animals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "production": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "threat_state": {
      "type": "object"
    },
    "survival_state": {
      "type": "object"
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "content_version": {
      "type": "string"
    },
    "operation_receipts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
