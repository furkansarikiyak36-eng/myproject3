{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Unitized Resource Amount",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "definition_id",
    "unit_id",
    "quantity"
  ],
  "properties": {
    "definition_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "quality": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "state_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
