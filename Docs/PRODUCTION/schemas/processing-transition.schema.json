{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Domain Processing Transition",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "transition_id",
    "domain_id",
    "source_state_id",
    "action_id",
    "target_state_id",
    "atomic_commit",
    "failure_codes"
  ],
  "properties": {
    "transition_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "source_state_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "target_state_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "required_tool_definition_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_station_definition_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      },
      "uniqueItems": true
    },
    "input_definition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      },
      "uniqueItems": true
    },
    "output_definition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      },
      "uniqueItems": true
    },
    "output_geometry_variant_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_parent_state_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "atomic_commit": {
      "const": true
    },
    "failure_codes": {
      "type": "array",
      "items": {
        "enum": [
          "INVALID_TARGET",
          "MISSING_TOOL",
          "MISSING_MATERIAL",
          "INVALID_STATE",
          "PREREQUISITE_NOT_MET",
          "MISSING_CONFIGURATION",
          "INSUFFICIENT_RESOURCES",
          "CONFLICT"
        ]
      },
      "uniqueItems": true
    },
    "tool_wear": {
      "type": "number",
      "minimum": 0
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "noise_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
