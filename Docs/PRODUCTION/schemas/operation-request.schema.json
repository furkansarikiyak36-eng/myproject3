{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 World Operation Request",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "operation_id",
    "operation_type",
    "target_instance_ids",
    "expected_revisions",
    "context"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "requester_instance_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_instance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "definition_ids": {
      "type": "object",
      "properties": {
        "tool_definition_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipe_definition_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "material_definition_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "expected_revisions": {
      "type": "object",
      "propertyNames": {
        "format": "uuid"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "hit_location": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "hit_normal": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_anchor_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_anchor_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth_layer": {
          "type": "integer",
          "minimum": 0
        },
        "client_preview_token": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
