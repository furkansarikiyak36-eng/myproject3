{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Committed World Event",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "operation_id",
    "affected_instance_ids",
    "world_tick",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "affected_instance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "world_tick": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    },
    "source_domain_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "source_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
