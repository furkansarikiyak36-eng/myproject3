{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Unique Owned Item Record",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "item_instance_id",
    "definition_id",
    "base_definition_id",
    "representation",
    "quantity",
    "owner_kind",
    "owner_id",
    "world_location",
    "revision"
  ],
  "properties": {
    "item_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "definition_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "base_definition_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "representation": {
      "enum": [
        "PHYSICAL_ACTOR",
        "STACKABLE_RESOURCE",
        "EQUIPMENT",
        "STORY_RECORD"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "owner_kind": {
      "enum": [
        "WORLD",
        "HELD",
        "INVENTORY",
        "STORAGE",
        "IN_TRANSIT",
        "CONSUMED",
        "TRANSFORMED"
      ]
    },
    "owner_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "world_location": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "domain_state": {
      "type": "object"
    },
    "actor_transform": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "location": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "rotation": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        },
        "scale": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": false
        }
      },
      "required": [
        "location",
        "rotation",
        "scale"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "owner_kind": {
            "enum": [
              "HELD",
              "INVENTORY",
              "STORAGE",
              "IN_TRANSIT"
            ]
          }
        },
        "required": [
          "owner_kind"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "owner_kind": {
            "enum": [
              "WORLD",
              "CONSUMED",
              "TRANSFORMED"
            ]
          }
        },
        "required": [
          "owner_kind"
        ]
      },
      "then": {
        "properties": {
          "owner_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "representation": {
            "const": "PHYSICAL_ACTOR"
          }
        },
        "required": [
          "representation"
        ]
      },
      "then": {
        "properties": {
          "quantity": {
            "const": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
