{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 World Operation Result",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "operation_id",
    "succeeded",
    "result_code",
    "message",
    "affected_instance_ids"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "succeeded": {
      "type": "boolean"
    },
    "result_code": {
      "enum": [
        "SUCCESS",
        "INVALID_TARGET",
        "OUT_OF_RANGE",
        "MISSING_TOOL",
        "MISSING_MATERIAL",
        "INVALID_STATE",
        "PREREQUISITE_NOT_MET",
        "BLOCKED_BY_PLACEMENT",
        "UNSUPPORTED_SURFACE",
        "CAPACITY_EXCEEDED",
        "NOT_PERMITTED",
        "MISSING_CONFIGURATION",
        "INSUFFICIENT_RESOURCES",
        "CONFLICT",
        "UNSUPPORTED",
        "INTERNAL_ERROR"
      ]
    },
    "message": {
      "type": "string"
    },
    "affected_instance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "resulting_revisions": {
      "type": "object",
      "propertyNames": {
        "format": "uuid"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "retry_of_operation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "succeeded": {
            "const": true
          }
        },
        "required": [
          "succeeded"
        ]
      },
      "then": {
        "properties": {
          "result_code": {
            "const": "SUCCESS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "succeeded": {
            "const": false
          }
        },
        "required": [
          "succeeded"
        ]
      },
      "then": {
        "properties": {
          "affected_instance_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
