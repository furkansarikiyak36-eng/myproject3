{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Item Definition",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "definition_id",
    "schema_version",
    "category",
    "representation",
    "mass_grams",
    "volume_cm3",
    "can_stack",
    "max_stack",
    "state_model",
    "durability_model",
    "allowed_actions",
    "persistence_policy"
  ],
  "properties": {
    "definition_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "category": {
      "enum": [
        "RAW_MATERIAL",
        "PROCESSED_MATERIAL",
        "TOOL",
        "EQUIPMENT",
        "CONSUMABLE",
        "SEED",
        "BUILD_PART",
        "STORY",
        "TECH_PART",
        "FOOD",
        "ANIMAL_PRODUCT"
      ]
    },
    "representation": {
      "enum": [
        "PHYSICAL_ACTOR",
        "STACKABLE_PICKUP",
        "EQUIPMENT_ONLY",
        "STORY_RECORD"
      ]
    },
    "mass_grams": {
      "type": "number",
      "minimum": 0
    },
    "volume_cm3": {
      "type": "number",
      "minimum": 0
    },
    "can_stack": {
      "type": "boolean"
    },
    "max_stack": {
      "type": "integer",
      "minimum": 1
    },
    "state_model": {
      "enum": [
        "NONE",
        "PROCESSING_STATE",
        "DURABILITY",
        "FILTER_LIFE",
        "FRESHNESS",
        "CONTAMINATION",
        "WETNESS",
        "CROP_STATE",
        "CUSTOM"
      ]
    },
    "durability_model": {
      "enum": [
        "NONE",
        "DURABILITY",
        "CONSUMABLE_CHARGES",
        "FILTER_LIFE",
        "FRESHNESS"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PICKUP",
          "DROP",
          "USE",
          "EQUIP",
          "PROCESS",
          "PLACE",
          "CONSUME",
          "INSPECT",
          "REPAIR",
          "CRAFT",
          "STORE",
          "TRANSPORT"
        ]
      }
    },
    "acquisition_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "recipe_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "world_actor_class": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "persistence_policy": {
      "enum": [
        "PERSIST_INSTANCE",
        "PERSIST_STACK",
        "RECREATE_FROM_REGION",
        "TRANSIENT",
        "STORY_FLAG"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "representation": {
            "const": "PHYSICAL_ACTOR"
          }
        },
        "required": [
          "representation"
        ]
      },
      "then": {
        "properties": {
          "can_stack": {
            "const": false
          },
          "max_stack": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "can_stack": {
            "const": false
          }
        },
        "required": [
          "can_stack"
        ]
      },
      "then": {
        "properties": {
          "max_stack": {
            "const": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
