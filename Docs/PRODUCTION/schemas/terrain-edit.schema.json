{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Bounded Terrain Edit",
  "$comment": "Design-time contract for MyProject3. It is not a claim that the corresponding Unreal runtime adapter is implemented or verified.",
  "type": "object",
  "required": [
    "operation_id",
    "cell",
    "depth_layer",
    "edit_kind",
    "material_id",
    "expected_revision"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "cell": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "depth_layer": {
      "type": "integer",
      "minimum": 0
    },
    "edit_kind": {
      "enum": [
        "EXCAVATE",
        "FILL",
        "REPLACE_MATERIAL"
      ]
    },
    "material_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "source_tool_definition_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "region_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_reason": {
      "type": "string",
      "maxLength": 512
    }
  },
  "additionalProperties": false
}
