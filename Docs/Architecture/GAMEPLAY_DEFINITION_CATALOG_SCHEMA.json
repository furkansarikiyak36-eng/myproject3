{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/myproject3/gameplay-definition-catalog.schema.json",
  "title": "MyProject3 Gameplay Definition Catalog",
  "description": "Planning schema for stable game-owned definitions. It is not yet wired into Unreal runtime loading.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "definitions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(ITEM|MAT|TOOL|BLD|RCP|CRP|REG)_[A-Z0-9]+(?:_[A-Z0-9]+)*$"
    },
    "positiveQuantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "PLANNED",
        "IMPLEMENTED_UNVERIFIED",
        "VERIFIED",
        "DEFERRED"
      ]
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionId",
        "quantity",
        "unitId"
      ],
      "properties": {
        "definitionId": {
          "$ref": "#/$defs/id"
        },
        "quantity": {
          "$ref": "#/$defs/positiveQuantity"
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionId",
        "kind",
        "version",
        "status"
      ],
      "properties": {
        "definitionId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "item",
            "material",
            "tool",
            "build_part",
            "recipe",
            "crop",
            "region"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "displayNameKey": {
          "type": "string",
          "minLength": 1
        },
        "descriptionKey": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "raw_material",
            "processed_material",
            "tool",
            "weapon",
            "building_part",
            "consumable",
            "protection",
            "seed",
            "story",
            "technology",
            "animal_product",
            "food",
            "other"
          ]
        },
        "worldRepresentation": {
          "type": "string",
          "enum": [
            "physical_actor",
            "stackable_pickup",
            "equipment_only",
            "story_record",
            "station_actor",
            "terrain_definition"
          ]
        },
        "massGrams": {
          "type": "number",
          "minimum": 0
        },
        "volumeCm3": {
          "type": "number",
          "minimum": 0
        },
        "maxStack": {
          "type": "integer",
          "minimum": 1
        },
        "durabilityModel": {
          "type": "string",
          "enum": [
            "none",
            "durability",
            "charges",
            "freshness",
            "filter_life"
          ]
        },
        "stateModel": {
          "type": "string"
        },
        "allowedActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "pickup",
              "drop",
              "carry",
              "equip",
              "use",
              "process",
              "place",
              "consume",
              "inspect",
              "repair",
              "store",
              "plant",
              "water",
              "harvest",
              "load",
              "unload"
            ]
          }
        },
        "acquisitionSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feedbackEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(EVT|SFX|VFX|ANIM|MUS)_[A-Z0-9_]+$"
          }
        },
        "worldActorClassId": {
          "type": "string"
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hardness",
            "diggable"
          ],
          "properties": {
            "hardness": {
              "type": "number",
              "minimum": 0
            },
            "diggable": {
              "type": "boolean"
            },
            "supportClass": {
              "type": "string",
              "enum": [
                "none",
                "soil",
                "weak_rock",
                "rock",
                "bedrock",
                "organic",
                "authored"
              ]
            },
            "contaminationClass": {
              "type": "string"
            },
            "moistureModel": {
              "type": "string"
            },
            "yieldDefinitionIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "buildPart": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "structureClass",
            "anchorProfileId"
          ],
          "properties": {
            "structureClass": {
              "type": "string",
              "minLength": 1
            },
            "anchorProfileId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "supportClass": {
              "type": "string"
            },
            "maxSpanCm": {
              "type": "number",
              "minimum": 0
            },
            "repairRecipeId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputs",
            "outputs",
            "atomicOnFailure"
          ],
          "properties": {
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/amount"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "consumed": {
                        "type": "boolean"
                      }
                    }
                  }
                ]
              }
            },
            "outputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/amount"
              }
            },
            "byproducts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/amount"
              }
            },
            "requiredToolId": {
              "$ref": "#/$defs/id"
            },
            "requiredStationId": {
              "type": "string"
            },
            "durationSeconds": {
              "type": "number",
              "minimum": 0
            },
            "toolWear": {
              "type": "number",
              "minimum": 0
            },
            "fuelCost": {
              "type": "number",
              "minimum": 0
            },
            "noiseLevel": {
              "type": "number",
              "minimum": 0
            },
            "preconditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "atomicOnFailure": {
              "type": "boolean",
              "const": true
            },
            "interruptionPolicy": {
              "type": "string",
              "enum": [
                "rollback",
                "resume_from_saved_progress",
                "complete_if_commit_started"
              ]
            }
          }
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sowingMonths",
            "growthDaysMin",
            "growthDaysMax",
            "harvestOutputs"
          ],
          "properties": {
            "sowingMonths": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            },
            "growthDaysMin": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "growthDaysMax": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "waterNeed": {
              "type": "number",
              "minimum": 0
            },
            "soilTags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "harvestOutputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/amount"
              }
            },
            "seedReturnOutputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/amount"
              }
            },
            "failureOrDormancyRule": {
              "type": "string"
            }
          }
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "regionKey",
            "baselineContamination"
          ],
          "properties": {
            "regionKey": {
              "type": "string",
              "pattern": "^REG_[A-Z0-9_]+$"
            },
            "baselineContamination": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "soilQuality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "waterQuality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "restorationMilestones": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "item"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "displayNameKey",
              "category",
              "worldRepresentation",
              "maxStack",
              "massGrams"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "material"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "displayNameKey",
              "material"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "displayNameKey",
              "category",
              "durabilityModel",
              "allowedActions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "build_part"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "displayNameKey",
              "worldRepresentation",
              "buildPart"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "recipe"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "displayNameKey",
              "recipe"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "crop"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "displayNameKey",
              "crop"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "region"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "displayNameKey",
              "region"
            ]
          }
        }
      ]
    }
  }
}
