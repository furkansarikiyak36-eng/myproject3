{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.myproject3.invalid/recipe-definition.schema.json",
  "title": "MyProject3 Recipe Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "inputs",
    "outputs",
    "preconditions",
    "operation",
    "transactionPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "Stable definition/event ID. Never use an M001-M119 mechanic ID or a display name here."
    },
    "displayNameKey": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definitionId",
          "quantity"
        ],
        "properties": {
          "definitionId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "requiredStateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            },
            "uniqueItems": true
          },
          "consumeOnSuccess": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definitionId",
          "quantity"
        ],
        "properties": {
          "definitionId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "resultStateId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "meshVariantSetId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "ownershipKind": {
            "enum": [
              "World",
              "Inventory",
              "Storage",
              "Transformed"
            ]
          }
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredToolDefinitionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "uniqueItems": true
        },
        "requiredStationDefinitionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "uniqueItems": true
        },
        "requiredRegionTags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "uniqueItems": true
        },
        "allowedSeasonIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "uniqueItems": true
        },
        "requiredWorldStateTags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "uniqueItems": true
        },
        "minimumToolCondition": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumRegionState": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "durationSeconds",
        "interruptionPolicy"
      ],
      "properties": {
        "mode": {
          "enum": [
            "Instant",
            "ProgressAction",
            "TimedWorldProcess"
          ]
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "interruptionPolicy": {
          "enum": [
            "KeepProgress",
            "ResetProgress",
            "CancelAndRefund"
          ]
        },
        "noiseLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lightLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fuelItemDefinitionId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "fuelQuantity": {
          "type": "integer",
          "minimum": 0
        },
        "waterQuantity": {
          "type": "number",
          "minimum": 0
        },
        "toolWear": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "transactionPolicy": {
      "const": "AtomicAtCommit"
    },
    "feedbackEventIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  }
}
