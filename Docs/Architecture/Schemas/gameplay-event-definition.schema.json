{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.myproject3.invalid/gameplay-event-definition.schema.json",
  "title": "MyProject3 Gameplay Event Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "domainEventType",
    "producerSystem",
    "commitTiming",
    "operationIdRequired",
    "deliveryPolicy",
    "mustNotMutateOwnerState"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "domainEventType": {
      "enum": [
        "ObjectProcessed",
        "ResourceConsumed",
        "ConstructionAttached",
        "ConstructionDetached",
        "ConstructionDamaged",
        "TerrainChanged",
        "CropStateChanged",
        "AnimalStateChanged",
        "WeatherChanged",
        "WorldHazardStarted",
        "WorldHazardEnded",
        "DiscoveryRecorded"
      ]
    },
    "producerSystem": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "commitTiming": {
      "const": "AfterAuthoritativeCommit"
    },
    "operationIdRequired": {
      "const": true
    },
    "payloadFieldIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      },
      "uniqueItems": true
    },
    "affectedObjectIdsIncluded": {
      "type": "boolean",
      "default": true
    },
    "deliveryPolicy": {
      "enum": [
        "TransientNotification",
        "TransientNotificationWithSnapshotState"
      ]
    },
    "mustNotMutateOwnerState": {
      "const": true
    },
    "notes": {
      "type": "string"
    }
  }
}
