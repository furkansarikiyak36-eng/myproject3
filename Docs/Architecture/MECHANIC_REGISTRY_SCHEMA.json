{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Survival Game Mechanic Registry Entry",
  "description": "Schema for mapping each confirmed mechanic to its owner, prerequisites, state changes, dependencies, persistence, and verification evidence.",
  "type": "object",
  "required": [
    "mechanic_id",
    "name",
    "phase",
    "owner_system",
    "status",
    "prerequisites",
    "state_changes",
    "failure_cases",
    "dependencies",
    "persistence",
    "verification"
  ],
  "properties": {
    "mechanic_id": {
      "type": "string",
      "pattern": "^M[0-9]{3}$",
      "description": "Stable ID, for example M001. Assign only after the source mechanic list is reconciled."
    },
    "name": { "type": "string", "minLength": 1 },
    "phase": { "type": "integer", "minimum": 1, "maximum": 16 },
    "owner_system": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "mapped",
        "implemented_unverified",
        "code_checked",
        "build_verified",
        "runtime_verified",
        "blocked",
        "deferred"
      ]
    },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "state_changes": { "type": "array", "items": { "type": "string" } },
    "failure_cases": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "persistence": {
      "type": "string",
      "enum": ["none", "transient", "save_required", "save_optional", "unknown"]
    },
    "verification": {
      "type": "object",
      "required": ["static_review", "automated_test", "unreal_build", "runtime_test"],
      "properties": {
        "static_review": { "type": "string", "enum": ["not_run", "pass", "fail", "blocked"] },
        "automated_test": { "type": "string", "enum": ["not_run", "pass", "fail", "blocked", "not_applicable"] },
        "unreal_build": { "type": "string", "enum": ["not_run", "pass", "fail", "blocked"] },
        "runtime_test": { "type": "string", "enum": ["not_run", "pass", "fail", "blocked"] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}