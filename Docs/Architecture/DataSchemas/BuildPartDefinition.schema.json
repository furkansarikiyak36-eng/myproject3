{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Build Part Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "part_id",
    "material_id",
    "geometry_state_id",
    "dimensions_cm",
    "pivot_convention",
    "long_axis",
    "collision_profile",
    "anchors",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "part_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "material_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "geometry_state_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "logical_asset_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "dimensions_cm": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "pivot_convention": {
      "enum": [
        "Center",
        "BottomCenter",
        "EndA",
        "CustomDocumented"
      ]
    },
    "long_axis": {
      "enum": [
        "X",
        "Y",
        "Z",
        "NotApplicable"
      ]
    },
    "collision_profile": {
      "enum": [
        "None",
        "QueryOnly",
        "PhysicsActor",
        "BlockAll",
        "Custom"
      ]
    },
    "interaction_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "support_class": {
      "enum": [
        "None",
        "Foundation",
        "Post",
        "Beam",
        "Surface",
        "Brace",
        "TerrainSupport",
        "Custom"
      ]
    },
    "removable_policy": {
      "enum": [
        "AlwaysIfUnattached",
        "OnlyIfNoDependents",
        "RequiresDismantle",
        "Never"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "planned",
        "implemented_unverified",
        "verified",
        "deferred"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "tag",
        "role",
        "local_position_cm",
        "outward_normal"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "role": {
          "enum": [
            "Source",
            "Receiver",
            "Both"
          ]
        },
        "local_position_cm": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "outward_normal": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "accepted_part_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "accepted_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "flip_incoming_orientation": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
