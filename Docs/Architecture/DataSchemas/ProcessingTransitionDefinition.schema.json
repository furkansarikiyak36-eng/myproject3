{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Processing State Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "domain_id",
    "from_state",
    "to_state",
    "identity_policy",
    "required_tool_ids",
    "preconditions",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "transition_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "from_state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "to_state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "target_definition_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "identity_policy": {
      "enum": [
        "PreserveInstance",
        "ConsumeAndSpawnOutputs",
        "ReplaceInstance",
        "RequiresDecision"
      ]
    },
    "required_tool_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "enum": [
          "WorldOwned",
          "NotHeld",
          "NotPlaced",
          "NoAttachedChildren",
          "RequiredTargetState",
          "RequiredToolPresent",
          "RequiredConfigurationPresent",
          "TargetNotDamaged",
          "OtherExplicitCheck"
        ]
      }
    },
    "required_output_asset_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "spawned_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition_id",
          "quantity",
          "representation"
        ],
        "properties": {
          "definition_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "representation": {
            "enum": [
              "PhysicalActor",
              "StackableItem"
            ]
          }
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "tool_wear": {
          "type": "number",
          "minimum": 0
        },
        "noise_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fuel_units": {
          "type": "number",
          "minimum": 0
        },
        "consumed_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        }
      }
    },
    "failure_policy": {
      "enum": [
        "NoMutation",
        "AtomicRollback",
        "DomainDefinedExplicitCost"
      ]
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "proposed",
        "planned",
        "implemented_unverified",
        "verified",
        "deferred"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
