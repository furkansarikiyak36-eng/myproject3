{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Item Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "display_name_key",
    "category",
    "world_representation",
    "max_stack",
    "mass_grams",
    "volume_cm3",
    "durability_model",
    "state_model",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "item_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "display_name_key": {
      "type": "string",
      "minLength": 1
    },
    "description_key": {
      "type": "string"
    },
    "category": {
      "enum": [
        "RawMaterial",
        "ProcessedMaterial",
        "Tool",
        "Weapon",
        "Equipment",
        "Consumable",
        "Seed",
        "BuildPart",
        "Story",
        "TechPart",
        "AnimalProduct",
        "Food",
        "Other"
      ]
    },
    "world_representation": {
      "enum": [
        "PhysicalActor",
        "StackablePickup",
        "EquipmentOnly",
        "StoryRecord",
        "BuildPart"
      ]
    },
    "max_stack": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999
    },
    "mass_grams": {
      "type": "integer",
      "minimum": 0
    },
    "volume_cm3": {
      "type": "integer",
      "minimum": 0
    },
    "unit_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "durability_model": {
      "enum": [
        "None",
        "Durability",
        "ConsumableCharges",
        "Freshness",
        "FilterLife"
      ]
    },
    "state_model": {
      "enum": [
        "None",
        "ProcessingState",
        "Wetness",
        "Contamination",
        "Freshness",
        "CropStage",
        "FilterLife",
        "Durability",
        "Custom"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "Pickup",
          "Drop",
          "Use",
          "Equip",
          "Process",
          "Place",
          "Consume",
          "Inspect",
          "Repair",
          "Split",
          "Stack",
          "Store",
          "Plant",
          "Harvest",
          "Transfer"
        ]
      }
    },
    "acquisition_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "recipe_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "logical_asset_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "feedback_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "stack_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stack_key_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "item_id",
              "condition",
              "freshness_bucket",
              "contamination_state",
              "quality_grade"
            ]
          }
        },
        "max_stack_weight_grams": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status": {
      "enum": [
        "proposed",
        "planned",
        "implemented_unverified",
        "verified",
        "deferred"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "world_representation": {
            "const": "PhysicalActor"
          }
        },
        "required": [
          "world_representation"
        ]
      },
      "then": {
        "properties": {
          "max_stack": {
            "const": 1
          }
        }
      }
    }
  ]
}
