{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Material Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "material_id",
    "display_name_key",
    "family",
    "hardness_tier",
    "diggable",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "material_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "display_name_key": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "Wood",
        "Stone",
        "Soil",
        "Sand",
        "Gravel",
        "Clay",
        "PlantFiber",
        "Water",
        "Metal",
        "Organic",
        "Synthetic",
        "Contaminated",
        "Other"
      ]
    },
    "hardness_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "diggable": {
      "type": "boolean"
    },
    "permitted_depth_layers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64
      }
    },
    "required_tool_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "contamination_class": {
      "enum": [
        "None",
        "Low",
        "Moderate",
        "High",
        "Unknown"
      ],
      "default": "None"
    },
    "moisture_affinity": {
      "enum": [
        "Dry",
        "Normal",
        "Moist",
        "Saturated",
        "NotApplicable"
      ]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "display_name_key"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "display_name_key": {
            "type": "string",
            "minLength": 1
          },
          "mass_grams": {
            "type": "integer",
            "minimum": 0
          },
          "volume_cm3": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "excavation_yields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "quantity",
          "unit_id"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "supports_excavation": {
      "type": "boolean",
      "default": false
    },
    "logical_asset_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "status": {
      "enum": [
        "proposed",
        "planned",
        "implemented_unverified",
        "verified",
        "deferred"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
