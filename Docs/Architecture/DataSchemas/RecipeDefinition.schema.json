{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyProject3 Recipe / Processing Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "version",
    "operation_kind",
    "inputs",
    "outputs",
    "interruption_policy",
    "failure_policy",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "operation_kind": {
      "enum": [
        "Craft",
        "Process",
        "Build",
        "Repair",
        "Cook",
        "Plant",
        "Harvest",
        "Clean",
        "Salvage",
        "Transform"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/itemAmount"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/itemAmount"
      }
    },
    "byproducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemAmount"
      }
    },
    "required_tool_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "required_station_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "domain": {
            "enum": [
              "Item",
              "Tool",
              "Terrain",
              "Weather",
              "Season",
              "Crop",
              "Structure",
              "Region",
              "Player"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "Equals",
              "NotEquals",
              "GreaterThan",
              "GreaterOrEqual",
              "LessThan",
              "LessOrEqual",
              "Contains",
              "HasTag"
            ]
          },
          "value": {}
        }
      }
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fuel_units": {
          "type": "number",
          "minimum": 0
        },
        "water_units": {
          "type": "number",
          "minimum": 0
        },
        "tool_wear": {
          "type": "number",
          "minimum": 0
        },
        "noise_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "light_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "interruption_policy": {
      "enum": [
        "Rollback",
        "KeepProgress",
        "ConsumeDefinedCost",
        "FinishAtomically"
      ]
    },
    "failure_policy": {
      "enum": [
        "NoMutation",
        "RollbackTransaction",
        "DomainDefinedExplicitCost"
      ]
    },
    "feedback_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "status": {
      "enum": [
        "proposed",
        "planned",
        "implemented_unverified",
        "verified",
        "deferred"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "itemAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "quantity"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "consume": {
          "type": "boolean",
          "default": true
        },
        "preserve_condition": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
